# Local-only directories and files. Never published.
nano/
web/
.claude/
LOCAL-NOTES.md

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Editor and IDE state
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# PHP runtime artefacts
*.log
error_log
php_errors.log

# Local config that must never be committed
/shop-config/
config.json
bootstrap.php

# Operator-populated content directories (only ship as seed-data/).
# Admin uploads write here in production; never commit operator data.
/products/
/categories/
/media/
/sitemap.xml

# Build / dependency caches (defensive. Nano Cart has none, but guards against
# accidental npm/composer introduction polluting the repo).
node_modules/
vendor/
composer.lock

# Release zips (built locally, uploaded to GitHub releases as assets
# rather than committed to source).
*.zip

# Test artefacts
.phpunit.result.cache
coverage/
