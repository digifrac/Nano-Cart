# Nano Cart - URL rewriting and security.
# Place at the shop root (/shop/.htaccess). Requires mod_rewrite.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS enforcement. Comment out if the front-end proxy already does it.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Skip rewriting for files and directories that actually exist
  # (assets/, media/, lib/, sitemap.xml, .htaccess, admin/).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Trailing-slash canonicalisation for category and product URLs.
  RewriteRule ^([a-z0-9][a-z0-9-]*[a-z0-9])/([a-z0-9][a-z0-9-]*[a-z0-9])$ /$1/$2/ [R=301,L]
  RewriteRule ^([a-z0-9][a-z0-9-]*[a-z0-9])$ /$1/ [R=301,L]

  # Route: /shop/<category>/<product>/
  RewriteRule ^([a-z0-9][a-z0-9-]*[a-z0-9])/([a-z0-9][a-z0-9-]*[a-z0-9])/?$ product.php?category=$1&product=$2 [QSA,L]

  # Route: /shop/<category>/
  RewriteRule ^([a-z0-9][a-z0-9-]*[a-z0-9])/?$ category.php?category=$1 [QSA,L]

  # Route: /shop/
  RewriteRule ^$ index.php [L]
</IfModule>

# Block access to PHP files in directories that should only serve assets.
<FilesMatch "\.(json|md|example\.php)$">
  Require all denied
</FilesMatch>

# Long cache on static assets (operators can override per asset).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg     "access plus 1 year"
  ExpiresByType image/webp     "access plus 1 year"
  ExpiresByType image/png      "access plus 1 year"
  ExpiresByType text/css       "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
